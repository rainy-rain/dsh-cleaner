# Dependencies
# Exclude root-level node_modules (for workspace) but allow dsh-cleaner/node_modules
# Use explicit file listing instead of a blanket rule
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Backup files
*.bak
workspace.json.bak-*

# Temp files
*.tmp
.cache/

# Root workspace files (not dsh-cleaner)
laser-homework/
_dsh-cleanup-backup/

